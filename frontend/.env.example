# =====================================================================
# CONFIGURAÇÕES DE AMBIENTE — studio (NUNCA versionar o arquivo .env!)
# =====================================================================
# ATENÇÃO DE SEGURANÇA:
# Jamais use o prefixo "VITE_" em chaves privadas (API_KEY, WATCHMODE_API_KEY),
# pois variáveis com prefixo VITE_ são embutidas no código público do navegador!

# Chave da API do The Movie Database (TMDB) — obrigatória (server-side)
API_KEY=sua_chave_tmdb_aqui

# Chave da Watchmode API — opcional (links diretos de streamings + ofertas grátis BR)
WATCHMODE_API_KEY=sua_chave_watchmode_aqui

# Origem extra permitida no CORS em produção — opcional (ex: domínio customizado)
# ALLOWED_ORIGIN=https://seu-dominio.com.br

# URL customizada da API para o frontend — opcional (por padrão usa "/api")
# VITE_API_URL=https://studiofilm.vercel.app/api
